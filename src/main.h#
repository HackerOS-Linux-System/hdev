mod tui_app
mod gui

use "std -> env" from "env"

fn usage() -> string is
    return "hdev — HackerOS developer tool\n\n"
        + "USAGE:\n"
        + "  hdev              open the file browser / editor here\n"
        + "  hdev <file>       edit <file> directly\n"
        + "  hdev app          browse github.com/" + org_name_for_usage() + " in a GUI window\n"
        + "  hdev --help       show this message\n"
end

fn org_name_for_usage() -> string is
    return "HackerOS-Linux-System"
end

fn main() is
    let args: [string] = env::args()   ;; args[0] is hdev's own path

    if args.len() < 2 is
        tui_app::run_editor("")
    elsif args[1] == "--help" || args[1] == "-h" is
        write(usage())
    elsif args[1] == "app" is
        gui::launch()
    else is
        tui_app::run_editor(args[1])
    end
end
